# Copy this file to ".env" for local development. NEVER commit ".env".
# On Render, add these under Environment instead of using a file.

# Required for AI features. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Change this if Google retires the default model.
# Current model names are listed at https://ai.google.dev/models
GEMINI_MODEL=gemini-3.8-flash

# Optional. API port for local development (Render sets PORT automatically).
PORT=8787

# Optional. Only needed if the frontend is hosted on a different domain.
# Comma-separated list, for example: https://my-site.example.com
ALLOWED_ORIGIN=

# Optional. Milliseconds to wait for Gemini before using the catalog fallback.
AI_TIMEOUT_MS=20000
